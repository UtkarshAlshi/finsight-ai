# ──────────────────────────────────────────────
# FinSight AI — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ──────────────────────────────────────────────

# ── LLM API Keys ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── LLM Routing ───────────────────────────────
# Model for cheap tasks (classification, lookup)
LLM_CHEAP_MODEL=claude-haiku-4-5-20251001
# Model for complex synthesis
LLM_PREMIUM_MODEL=claude-sonnet-4-6
# OpenAI fallback
LLM_OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://finsight:finsight@localhost:5433/finsight
POSTGRES_SYNC_DSN=postgresql://finsight:finsight@localhost:5433/finsight

# ── Vector DB ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=finsight_docs

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92

# ── Kafka / Redpanda ──────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_NEWS_TOPIC=financial_news
KAFKA_GROUP_ID=finsight_consumer

# ── Observability ─────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=finsight-api

# ── SEC EDGAR ─────────────────────────────────
# Must be "AppName contact@email.com" per EDGAR fair-use policy
SEC_EDGAR_USER_AGENT=FinSightAI contact@example.com
SEC_EDGAR_BASE_URL=https://data.sec.gov
SEC_TICKERS=AAPL,MSFT,GOOGL,META,AMZN,NVDA,TSLA,JPM,V,WMT

# ── RAG ───────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── App ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
