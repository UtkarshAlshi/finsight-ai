# ──────────────────────────────────────────────
# FinSight AI — Environment Variables
# Copy to .env and fill in values. Never commit .env.
#
# Required keys are marked [REQUIRED].
# Optional keys have working defaults and can be left blank.
# ──────────────────────────────────────────────

# ── LLM API Keys ──────────────────────────────
# [REQUIRED] Primary LLM provider. Must have active billing credit for
# synthesis to work. Retrieval runs without this key.
OPENAI_API_KEY=sk-...

# [OPTIONAL] Fallback LLM provider. Only needed if testing the Anthropic path.
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM Routing ───────────────────────────────
# Cheap-tier model: used for classification, critic checks, low-complexity tasks.
LLM_CHEAP_MODEL=gpt-4o-mini
# Premium model: used for final synthesis.
LLM_PREMIUM_MODEL=gpt-4o
# [OPTIONAL] Anthropic equivalents — only used when ANTHROPIC_API_KEY is set.
LLM_ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001
LLM_ANTHROPIC_PREMIUM_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────
# Port 5433 (not 5432) to avoid conflict with a system-level Postgres.
# See docs/runbooks/local-setup.md for details.
POSTGRES_DSN=postgresql+asyncpg://finsight:finsight@localhost:5433/finsight
POSTGRES_SYNC_DSN=postgresql://finsight:finsight@localhost:5433/finsight

# ── Vector DB ─────────────────────────────────
QDRANT_URL=http://localhost:6333
# [OPTIONAL] Only needed for cloud-hosted Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=finsight_docs

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600
# Cosine similarity threshold for semantic cache hits (0–1). Higher = stricter.
SEMANTIC_CACHE_THRESHOLD=0.92

# ── Kafka / Redpanda ──────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_NEWS_TOPIC=financial_news
KAFKA_GROUP_ID=finsight_consumer

# ── Observability ─────────────────────────────
# [OPTIONAL] Langfuse Cloud trace observability.
# Get keys at cloud.langfuse.com. Leave blank to disable LLM tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# [OPTIONAL] OpenTelemetry OTLP endpoint. Leave blank to disable OTel export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=finsight-api

# ── SEC EDGAR ─────────────────────────────────
# [REQUIRED] Must follow "AppName contact@email.com" format per EDGAR fair-use policy.
SEC_EDGAR_USER_AGENT=FinSightAI contact@example.com
SEC_EDGAR_BASE_URL=https://data.sec.gov
# Tickers to ingest. Phase 1 seeds AAPL + MSFT. Expand in Phase 2.
SEC_TICKERS=AAPL,MSFT

# ── RAG ───────────────────────────────────────
# Self-hosted embedding model (1024-dim). Loaded once at API startup.
# Uses MPS on host (Apple Silicon), CPU inside Docker.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
# Number of BM25 + dense candidates before reranking.
RETRIEVAL_TOP_K=20
# Number of chunks returned after reranking.
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── App ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
